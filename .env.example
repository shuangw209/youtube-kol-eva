# Copy this file to `.env` and fill in your values.
#
# Get your YouTube Data API v3 key from https://console.cloud.google.com/
# (See README, "第一次安装：开 YouTube API key" — has step-by-step.)
YOUTUBE_API_KEY=

# Default currency label for the price you pass on the command line.
# Just a label — does no FX conversion.
DEFAULT_CURRENCY=USD

# How many recent uploads to sample by default. The script skips Shorts
# automatically when possible (YouTube doesn't always tag them, so it's
# best-effort).
DEFAULT_RECENT_N=10

# How many top-level comments to pull per video for the authenticity check.
DEFAULT_COMMENTS_PER_VIDEO=100

# Industry vertical for CPM benchmarking. Choose one of:
#   tech_ai    (your default; CPM under 80 USD acceptable)
#   gaming
#   beauty
#   generic
DEFAULT_VERTICAL=tech_ai
